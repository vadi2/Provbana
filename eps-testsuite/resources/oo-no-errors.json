{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FHIR validation outcome: no errors allowed",
  "type": "object",
  "required": ["resourceType"],
  "properties": {
    "resourceType": { "const": "OperationOutcome" },
    "issue": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": ["information", "warning"],
            "description": "Validation issues of severity 'error' or 'fatal' fail the test"
          }
        }
      }
    }
  }
}
