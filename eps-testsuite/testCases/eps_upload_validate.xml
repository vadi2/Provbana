<?xml version="1.0" encoding="UTF-8"?>
<testcase id="eps_upload_validate" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>Upload and validate a Patient Summary</gitb:name>
    <gitb:version>1.1</gitb:version>
    <gitb:description>The producer provides a European Patient Summary document; it is validated against the HL7 EU EPS 1.0.0-ballot FHIR profiles (full profile validation via Matchbox).</gitb:description>
  </metadata>
  <imports>
    <artifact name="ooSchema">resources/oo-no-errors.json</artifact>
  </imports>
  <actors>
    <gitb:actor id="PS-Producer" name="Patient Summary Producer" role="SUT"/>
    <gitb:actor id="Validator" name="EPS Validator" role="SIMULATED"/>
  </actors>
  <variables>
    <var name="summary" type="string"/>
  </variables>
  <steps stopOnError="true">
    <interact id="upload" desc="Provide the Patient Summary" inputTitle="Patient Summary">
      <request desc="Patient Summary document (FHIR JSON):" name="summary" inputType="UPLOAD" contentType="STRING">$summary</request>
    </interact>
    <assign to="headers" type="map"/>
    <assign to="$headers{Content-Type}">"application/fhir+json"</assign>
    <send id="callValidator" desc="Validate against EPS 1.0.0-ballot (Matchbox)" handler="HttpMessagingV2">
      <input name="uri">"http://matchbox:8080/matchboxv3/fhir/$validate?profile=http://hl7.eu/fhir/eps/StructureDefinition/bundle-eu-eps"</input>
      <input name="method">"POST"</input>
      <input name="body">$summary</input>
      <input name="headers">$headers</input>
    </send>
    <verify id="checkProfile" handler="JsonValidator" desc="Check the validation outcome (no errors or fatals allowed)">
      <input name="json">$callValidator{response}{body}</input>
      <input name="schema">$ooSchema</input>
    </verify>
  </steps>
  <output>
    <success><default>"The document is a valid European Patient Summary (EPS 1.0.0-ballot)."</default></success>
    <failure><default>"The document failed EPS 1.0.0-ballot profile validation. See the OperationOutcome details in the report."</default></failure>
  </output>
</testcase>
