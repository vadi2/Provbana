# Copy to .env on the VPS beside docker-compose.prod.yml. Compose reads .env
# automatically; it is gitignored because REGISTER_CODE belongs in it.

# The hostname Caddy gets a certificate for. Must already resolve to this box,
# DNS-only (grey cloud) in Cloudflare, or the ACME challenge fails.
SITE_ADDRESS=hackathon2026.vadimperetok.in

# The matchbox image hardcodes -Xmx12g, which is more than a 16 GB box has to
# give once the service, Caddy and the page cache have taken their share.
#   16 GB box (CX43):  MATCHBOX_HEAP=8g   MATCHBOX_MEM_LIMIT=10g
#   32 GB box (CX53):  MATCHBOX_HEAP=20g  MATCHBOX_MEM_LIMIT=24g
# The limit needs headroom over the heap for metaspace, code cache and thread
# stacks - if they are set equal the kernel OOM-kills the validator instead of
# the JVM raising an error you can find in the log. Measured on the CX53: about
# 3 GB of non-heap on top of the heap actually in use, so the 4g gap above is
# not generous. Nor is what is left of the box: there is no swap, and the other
# containers, the kernel and the page cache want a couple of GB that nothing
# reserves for them. The limits are a ceiling, not a budget to spend up to.
#
# The heap is deliberately far larger than the validator's working set, which
# is around 7 GB. Matchbox does not hold its compiled validation engines hard,
# and HotSpot clears soft references in proportion to free heap
# (-XX:SoftRefLRUPolicyMSPerMB, 1000ms per free MB), so a snug heap drops them
# after tens of minutes idle and the next submission of that kind pays the
# two-minute compile again. The warm sidecar in docker-compose.prod.yml is the
# actual fix for that; the spare heap is the belt to its braces.
MATCHBOX_HEAP=8g
MATCHBOX_MEM_LIMIT=10g

# How long a submitting client waits on the validator. Measured on the CX53:
# under 2s once warm, but 64s for the very first validation after a restart,
# because Matchbox compiles the profile snapshots lazily - which is why
# deploy/deploy.sh warms it rather than this being raised past 60.
MATCHBOX_TIMEOUT=60

# Until the hackathon starts the service is open so teams can practise, and
# reset.py empties the leaderboard daily so a September trial run is not still
# leading in November. This one timestamp sets both the daily wipe time and the
# last day one happens - the wipe falling exactly on it is the final one, so
# the value below means "03:00 UTC daily, last wipe the morning the doors open
# on 18 November". The page reads it too, and stops advertising practice mode
# at the same instant. Leave it unset for an ordinary deployment: no wipes are
# scheduled and no notice is shown.
PRACTICE_ENDS=2026-11-18T03:00:00Z

# FHIR Subscriptions: the notify container POSTs to endpoints participants
# register, and refuses any that is not a public address - this box sits next
# to an unauthenticated validator and a cloud metadata service. Leave this
# unset here. It exists for a deployment on a venue LAN, where every
# participant's machine is a private address and the rule would refuse them all.
SUBSCRIPTION_ALLOW_PRIVATE=

# Where the monitor container mails alerts (the service erroring, or $status
# not "up" for five minutes) and the daily digest (06:00 UTC unless DIGEST_HOUR
# says otherwise). Any SMTP account will do - a Gmail address with an app
# password (smtp.gmail.com) works. Use port 587: Hetzner Cloud blocks outbound
# 25 and 465. Leave SMTP_HOST empty and the messages go to
# `docker compose -f docker-compose.prod.yml logs monitor` instead.
MAIL_TO=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Leave empty and anyone who finds the URL can register a team. The box is
# public from the day it goes up, so set this before the event and hand the
# code to the teams.
REGISTER_CODE=
